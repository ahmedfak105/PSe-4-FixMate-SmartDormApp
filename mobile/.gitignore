# Generated translations (flutter gen-l10n runs on every pub get / run)
/lib/l10n/gen/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment files with real keys – only *.example.json go to Git
/env/*.json
!/env/*.example.json
